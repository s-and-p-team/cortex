# One probe image per row: the library under test on a stock python base.
# A throwaway test image: unpinned base, root, ${PIP} word-split on purpose.
FROM docker.io/library/python:3.12-slim
ARG PIP
RUN [ -z "${PIP}" ] || pip install --no-cache-dir --root-user-action=ignore ${PIP}
WORKDIR /probe
COPY sink.py driver.py clients.py servers.py ./
ENV PYTHONPATH=/probe
